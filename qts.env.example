# 复制本文件为 qts.env 后按需修改；qts.env 已被 Git 忽略，不会提交。
# 应用启动时自动读取项目根目录下的 qts.env，不需要在 IDEA 里再配环境变量。
# 不创建 qts.env 时默认使用本地 JSON 存储（local）。

# ===== 首次配置 PostgreSQL（推荐先用 postgres 超级用户跑通）=====
QTS_PROFILE=postgresql
QTS_DB_URL=jdbc:postgresql://127.0.0.1:5432/ui_testcase_studio
QTS_DB_USERNAME=postgres
QTS_DB_PASSWORD=你的postgres密码

# 说明：
# 1. 数据库 ui_testcase_studio 不需要手工创建，首次启动会自动建库；
# 2. 表由 Flyway 自动创建，共 15 张；
# 3. postgres 是超级用户，天然有建库权限。

# ===== 可选：改用专用账号 =====
# 先在数据库里执行：
#   CREATE USER qts WITH PASSWORD '你的qts密码' CREATEDB;
# 然后把上面两行改成：
# QTS_DB_USERNAME=qts
# QTS_DB_PASSWORD=你的qts密码

# ===== 可选：关闭自动建库 =====
# 已经手工建好库时设置；默认 true。
# QTS_AUTO_CREATE_DB=false

# ===== 可选：端口与监听地址 =====
# QTS_PORT=8080
# QTS_HOST=0.0.0.0

# ===== 可选：截图与数据目录 =====
# QTS_DATA_DIR=./data

# ===== 可选：AI 模型（当前版本只展示配置状态，尚未接入识别调用）=====
# QTS_AI_BASE_URL=https://api.openai.com/v1
# QTS_AI_MODEL=
# QTS_AI_API_KEY=
